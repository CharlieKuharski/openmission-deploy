OPENMISSION_VERSION=0.1.0-rc.8
DOCKERHUB_NAMESPACE=charliekuharski

# Projects and SQLite data are stored in ./workspace and ./data by default.
# Uncomment these optional overrides to use other absolute host paths.
# OPENMISSION_HOST_WORKSPACE_ROOT=/srv/openmission/workspace
# OPENMISSION_DATA_ROOT=/srv/openmission/data

# Local-only defaults. Replace all three before remote access, reverse-proxy
# exposure, cloud deployment, or use on a shared machine.
HERMES_API_KEY=openmission-local-hermes-key-change-me
BROWSERLESS_TOKEN=openmission-local-browserless-token-change-me
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=openmission-local-dashboard-password-change-me

OPENMISSION_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENMISSION_OLLAMA_MODEL=qwen3-coder:30b
OPENMISSION_CHAT_MODEL=hermes3:8b
OPENMISSION_CODE_GEN_MODEL=qwen3-coder:30b
